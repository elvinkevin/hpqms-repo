# Copy this file to .env and replace each value before starting the stack.
# Use URL-safe secrets (letters, digits, "-" and "_") for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
SECRET_KEY=
KIOSK_INTERNAL_API_KEY=
ENVIRONMENT=production

# Required to create the first administrator on a fresh database.
INITIAL_ADMIN_EMPLOYEE_ID=
INITIAL_ADMIN_PASSWORD=
